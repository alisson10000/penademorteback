INSERT INTO `questions` VALUES (1,'FOI DEUS QUEM CRIOU A PENA DE MORTE? GENESIS 9:5,6','[{\"bold\": true, \"text\": \"1- FOI DEUS QUEM CRIOU A PENA DE MORTE? \", \"color\": \"#0000FF\"}, {\"bold\": true, \"text\": \"GÊNESIS 9:5,6\", \"color\": \"#FF0000\"}]',1,1),(2,'2 – O AUTOR DO APP MISTER GANDHI AFIRMA QUE  A “LEI DA PENA DE MORTE” JÁ ESTÁ INSTAURADA NO BRASIL, SENDO SANCIONADA PELO CONGRESSO, RATIFICADA PELO CÓDIGO PENAL E PELO ECA E HOMOLOGADA PELO STF.\r\nVOCÊ ACHA QUE ELE ESTÁ CERTO?','[{\"bold\": true, \"text\": \"2 – O AUTOR DO APP MISTER GANDHI AFIRMA QUE A A “LEI DA PENA DE MORTE” JÁ ESTÁ INSTAURADA NO BRASIL, SENDO SANCIONADA PELO CONGRESSO, RATIFICADA PELO CÓDIGO PENAL E PELO ECA E HOMOLOGADA PELO STF.\\n\", \"color\": \"#0000FF\"}, {\"bold\": true, \"text\": \"VOCÊ ACHA QUE ELE ESTÁ CERTO?\", \"color\": \"#FF0000\"}]',1,2),(3,'EXISTE JUSTIÇA PARA ASSASSINOS NO BRASIL?\nJUSTIÇA É A IGUALDADE DE DIREITO ONDE A PENA É IGUAL AO DELITO, E CASO HAJA DESIGUALDADE ENTRE AMBOS HOUVE INJUSTIÇA.','[{\"bold\": true, \"text\": \"3- EXISTE JUSTIÇA PARA ASSASSINOS NO BRASIL?\\n\", \"color\": \"#0000FF\"}, {\"bold\": true, \"text\": \"JUSTIÇA É A IGUALDADE DE DIREITO ONDE A PENA É IGUAL AO DELITO, E CASO HAJA DESIGUALDADE ENTRE AMBOS HOUVE INJUSTIÇA.\", \"color\": \"#FF0000\"}]',1,3),(4,'UM BANDIDO MATA TODA UMA FAMÍLIA E GANHA 30 ANOS DE PRISÃO E SAI CUMPRIDO 1/3 DA PENA (DEZ ANOS). HOUVE JUSTIÇA?\nAQUELAS VIDAS SÓ VALEM DEZ ANOS DE PRISÃO DA VIDA DO ASSASSINO? O DIREITO DO ASSASSINO É MAIOR QUE O DO MORTO? UM É CIDADÃO DE 1ª E O OUTRO DE 2ª?\nART. 5º DA CONSTITUIÇÃO: Todos são iguais perante a lei, sem distinção de qualquer natureza...,etc.','[{\"bold\": true, \"text\": \"4- UM BANDIDO MATA TODA UMA FAMÍLIA E GANHA 30 ANOS DE PRISÃO E SAI CUMPRIDO 1/3 DA PENA (DEZ ANOS). HOUVE JUSTIÇA?\\n\", \"color\": \"#0000FF\"}, {\"bold\": true, \"text\": \"AQUELAS VIDAS SÓ VALEM DEZ ANOS DE PRISÃO DA VIDA DO ASSASSINO? O DIREITO DO ASSASSINO É MAIOR QUE O DO MORTO?\\n\", \"color\": \"#FF0000\"}, {\"bold\": true, \"text\": \"UM É CIDADÃO DE 1ª E O OUTRO DE 2ª? UM É FILHO DE DEUS E OUTRO ENTEADO OU FILHO DO DIABO?\\n\", \"color\": \"#FF0000\"}, {\"bold\": true, \"text\": \"ART. 5º DA CONSTITUIÇÃO: Todos são iguais perante a lei, sem distinção de qualquer natureza...,etc.\", \"color\": \"#008000\"}]',1,4),(5,'VOCÊ É A FAVOR DA “PENA DE MORTE” PARA FEMINICIDA, ASSASSINO DE MULHER (ESPOSA, NAMORADA, ETC)?\nE QUE OS SEUS BENS SEJAM ESPOLIADOS PARA RESSARCIR AOS FAMILIARES DA VÍTIMA.\nCERCA DE 10 MULHERES SÃO ASSASSINADAS TODOS OS DIAS NO BRASIL.\n“A LEI MARIA DA PENHA” SÓ DIMINUIU EM 10% O FEMINICÍDIO NO BRASIL.','[{\"bold\": true, \"text\": \"5-VOCÊ É A FAVOR DA “PENA DE MORTE” PARA FEMINICIDA, ASSASSINO DE MULHER \", \"color\": \"#0000FF\"}, {\"bold\": true, \"text\": \"(ESPOSA, NAMORADA, ETC)?\\n\", \"color\": \"#FF0000\"}, {\"bold\": true, \"text\": \"E QUE OS SEUS BENS SEJAM ESPOLIADOS PARA RESSARCIR AOS FAMILIARES DA VÍTIMA.\\n\", \"color\": \"#0000FF\"}, {\"bold\": true, \"text\": \"CERCA DE 10 MULHERES SÃO ASSASSINADAS TODOS OS DIAS NO BRASIL.\\n\", \"color\": \"#008000\"}, {\"bold\": true, \"text\": \"“A LEI MARIA DA PENHA” SÓ DIMINUIU EM 10% O FEMINICÍDIO NO BRASIL.\", \"color\": \"#008000\"}]',1,5),(6,'TALVEZ VOCÊ NÃO SEJA A FAVOR DA “PENA DE MORTE”, MAS VOCÊ CONCORDA COM A “LEI GANDHI ANTI-FEMINICÍDIO” DE PROTEÇÃO À VIDA E À INTEGRIDADE FÍSICA DA MULHER (“LEI DA IGUALITARIEDADE DE DIREITOS”, “LEI DA JUSTA RECOMPENSA”):\nSE ALGUÉM AGRIDE-A, FERINDO-A, MUTILANDO-A, INCENDIANDO-A, CAUSANDO-LHE MALES E DEFORMAÇÕES FÍSICAS, SEJA-LHE FEITO O MESMO, NA MESMA PROPORÇÃO, MAIS A PENA DE PRISÃO PREVISTA NA LEI E A ESPOLIAÇÃO DOS SEUS BENS PARA INDENIZAÇÃO À REFERIDA MULHER?\nCERCA DE 21 MILHÕES DE MULHERES FORAM AGREDIDAS E ESPANCADAS EM 2017.','[{\"bold\": true, \"text\": \"6 – TALVEZ VOCÊ NÃO SEJA A FAVOR DA “PENA DE MORTE”, MAS VOCÊ CONCORDA COM A \", \"color\": \"#0000FF\"}, {\"bold\": true, \"text\": \"\\\"LEI GANDHI ANTI-FEMINICÍDIO\\\"